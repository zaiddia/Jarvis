# Copia este archivo como ".env" (junto a jarvis.py o jarvis.exe) y quita el # de lo que quieras usar.
# Lo que pongas aquí manda sobre los Ajustes y NUNCA se guarda en config.json.
# Ideal para claves de API o para llevar tu configuración en la USB.

# --- IA con Ollama en otro equipo de la red (p. ej. el PC de casa o del aula) ---
# OLLAMA_HOST=http://192.168.1.20:11434
# OLLAMA_MODEL=llama3.2

# --- IA con un servicio compatible OpenAI ---
# JARVIS_AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.ejemplo.com/v1
# OPENAI_API_KEY=pon-aqui-tu-clave
# OPENAI_MODEL=nombre-del-modelo

# --- Cualquier otro ajuste, con el prefijo JARVIS_ ---
# JARVIS_TTS_VOICE=es-CO-GonzaloNeural
# JARVIS_THEME=rojo
# JARVIS_HUD_START_SIZE=orbe
# JARVIS_WAKE_WORD_ENABLED=true

# --- IA en la nube: elige UN proveedor y pon su clave ---
# Proveedores: gemini, anthropic (Claude), chatgpt, deepseek, kimi, xai (Grok), mistral, groq, openrouter
# JARVIS_AI_PROVIDER=gemini
# GEMINI_API_KEY=tu-clave
# JARVIS_GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...
# CHATGPT_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...          (Kimi)
# XAI_API_KEY=xai-...              (Grok)
# MISTRAL_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
