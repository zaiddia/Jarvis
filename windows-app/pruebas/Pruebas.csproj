<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pruebas automáticas de JARVIS. En Windows prueban el motor de órdenes completo;
       en otros sistemas (o sin las piezas de Windows), solo el texto y las cuentas. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Jarvis.Pruebas</RootNamespace>
    <AssemblyName>Pruebas</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS0067;CS0649;CS0169;CS0414;CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);COMPLETO</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <None Include="frases.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows: todo el código de JARVIS menos el arranque (App.cs tiene su propio Main). -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Include="..\codigo\**\*.cs" Exclude="..\codigo\App.cs;..\codigo\obj\**;..\codigo\bin\**" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Include="../codigo/Core/Text.cs;../codigo/Commands/Calc.cs" />
  </ItemGroup>
</Project>
